{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "esModuleInterop": true
  },
  "include": ["api/**/*.ts", "server/**/*.ts", "shared/**/*.ts", "chains/solana/**/*.ts", "tests/**/*.ts", "scripts/**/*.mts"]
}
