{
  "name": "gasless",
  "private": true,
  "version": "0.1.0",
  "description": "Clean, move, swap, bridge, and use supported assets without first acquiring native gas.",
  "license": "Apache-2.0",
  "homepage": "https://gasless.exchange",
  "repository": {
    "type": "git",
    "url": "https://github.com/gaslessdex/gasless.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env.local --import tsx server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node tests/ui/cross-chain-layout.mjs && node tests/ui/stats-layout.mjs && node tests/ui/mobile-layout.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@react-three/fiber": "^9.7.0",
    "@sentry/node": "10.70.0",
    "@sentry/react": "^10.70.0",
    "@solana/connector": "0.2.6",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-standard-chains": "^1.1.2",
    "@solana/wallet-standard-features": "^1.3.0",
    "@solana/web3.js": "^1.98.4",
    "@vitejs/plugin-react": "^5.0.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "@walletconnect/universal-provider": "^2.23.10",
    "bs58": "6.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/bs58": "4.0.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "playwright": "^1.61.0",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.34.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "uuid": "11.1.1"
  }
}
