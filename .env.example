# Browser-safe local configuration
VITE_APP_NETWORK=devnet
VITE_APP_OPERATING_MODE=devnet
VITE_API_BASE_URL=http://localhost:8787
VITE_WALLETCONNECT_PROJECT_ID=
VITE_SENTRY_DSN=

# Server runtime
GASLESS_OPERATING_MODE=devnet
GASLESS_NETWORK=devnet
GASLESS_API_PORT=8787
SOLANA_RPC_URL=
SOLANA_FALLBACK_RPC_URL=
HELIUS_API_KEY=

# Jupiter
JUPITER_API_URL=https://api.jup.ag/swap/v2
JUPITER_PRICE_API_URL=https://api.jup.ag/price/v3
JUPITER_API_KEY=

# Local Devnet relayer. Use only an ignored local keypair.
RELAYER_PROVIDER=local-devnet
RELAYER_KEYPAIR_PATH=

# Optional local persistence and observability
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=

# Relay quotes. Keep the API key server-side; execution is off by default.
RELAY_API_KEY=
CROSS_CHAIN_ENABLED=false

# Tests/local development only. Never enable memory stores in a deployment.
GASLESS_ALLOW_MEMORY_STORES=false
