# Browser-safe configuration
VITE_APP_NETWORK=devnet
VITE_API_BASE_URL=http://localhost:8787
VITE_WALLETCONNECT_PROJECT_ID=

# Server-only configuration — never expose through VITE_* variables
GASLESS_OPERATING_MODE=devnet
GASLESS_NETWORK=devnet
GASLESS_API_PORT=8787
SOLANA_RPC_URL=
SOLANA_FALLBACK_RPC_URL=
HELIUS_API_KEY=
JUPITER_API_URL=https://api.jup.ag/swap/v2
JUPITER_PRICE_API_URL=https://api.jup.ag/price/v3
JUPITER_API_KEY=

# Local Devnet relayer. Use an ignored local keypair only.
RELAYER_PROVIDER=local-devnet
RELAYER_KEYPAIR_PATH=

# Optional durable/shared services for local development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Private deployment variable names are documented without values.
KORA_RPC_URL=
KORA_AUTH_TOKEN=
KORA_EXPECTED_PAYER=
RECOVER_AUTHORIZATION_SECRET_KEY=
RECOVER_AUTHORIZATION_PUBLIC_KEY=
PILOT_WALLET_ALLOWLIST=
CLAIM_FEE_DESTINATION=
BURN_FEE_DESTINATION=
RECOVER_FEE_DESTINATION=
SEND_REIMBURSEMENT_WALLET=
SEND_SERVICE_FEE_WALLET=
SWAP_REIMBURSEMENT_WALLET=
SWAP_SERVICE_FEE_WALLET=
SEND_TOKEN_REGISTRY_JSON=[]
SWAP_TOKEN_REGISTRY_JSON=[]
RECOVER_ALLOWED_MINTS=
